{
  "name": "ivac-extention",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && npm run copy-assets",
    "copy-assets": "powershell -NoProfile -Command \"Copy-Item -Force manifest.json dist/; New-Item -ItemType Directory -Force dist/icons | Out-Null; if (Test-Path public/icons) { Copy-Item -Path public/icons/* -Destination dist/icons/ -Recurse -Force }\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
